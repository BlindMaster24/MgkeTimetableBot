{
    "compilerOptions": {
        "target": "ESNext",
        "moduleResolution": "Node",
        "module": "CommonJS",
        "ignoreDeprecations": "6.0",
        "incremental": true,
        "tsBuildInfoFile": ".tsbuildinfo",
        "strict": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./build/",
        "removeComments": true,
        "skipLibCheck": true,
        "lib": ["DOM", "ESNext"],
        "importHelpers": true,
        "sourceMap": true,
        "types": ["node", "./src/@types/viber-bot"]
    },
    "exclude": ["build", "node_modules", "@types"]
}
